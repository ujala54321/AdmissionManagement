@{
}
@model ProgramFormVm

<h2>Edit Program</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div>
        <label>Code</label>
        <input asp-for="Code" class="form-control" />
    </div>

    <div>
        <label>Department</label>
        <select asp-for="DepartmentId"
                asp-items="@(new SelectList(Model.Departments, "Id", "Name"))"
                class="form-control">
        </select>
    </div>

    <div>
        <label>Course Type</label>
        <input asp-for="CourseType" class="form-control" />
    </div>

    <div>
        <label>Entry Type</label>
        <input asp-for="EntryType" class="form-control" />
    </div>

    <div>
        <label>Admission Mode</label>
        <input asp-for="AdmissionMode" class="form-control" />
    </div>

    <div>
        <label>Duration (Years)</label>
        <input asp-for="DurationYears" class="form-control" />
    </div>

    <br />

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>
