@{
}
@model AdmissionManagement.Models.SeatMatrix

<h2>Delete Seat Matrix</h2>

<h4>Are you sure you want to delete this?</h4>

<div>
    <p><strong>Total Intake:</strong> @Model.TotalIntake</p>
    <p><strong>KCET:</strong> @Model.KcetSeats</p>
    <p><strong>COMEDK:</strong> @Model.ComedkSeats</p>
    <p><strong>Management:</strong> @Model.ManagementSeats</p>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>