@model List<SeatMatrix>

@{
    ViewData["Title"] = "Seat Matrix";
}

<div class="seat-matrix-container">
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="page-title">
                    <i class="fas fa-th"></i> Seat Matrix
                </h1>
                <a href="~/SeatMatrix/Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add Seat Matrix
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card card-dark">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-sm">
                            <thead>
                                <tr>
                                    <th>Program</th>
                                    <th>Academic Year</th>
                                    <th>Total Intake</th>
                                    <th>KCET</th>
                                    <th>COMEDK</th>
                                    <th>Management</th>
                                    <th>Supernumerary</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Count == 0)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center text-muted py-4">
                                            No seat matrix records found
                                        </td>
                                    </tr>
                                }
                                @foreach (var seat in Model)
                                {
                                    <tr>
                                        <td><strong>@seat.Program.Name</strong></td>
                                        <td>@seat.AcademicYear.Label</td>
                                        <td>@seat.TotalIntake</td>
                                        <td>@seat.KcetSeats</td>
                                        <td>@seat.ComedkSeats</td>
                                        <td>@seat.ManagementSeats</td>
                                        <td>@seat.SupernumerarySeats</td>
                                        <td>
                                            <a href="~/SeatMatrix/Edit/@seat.Id" class="btn btn-sm btn-info">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a href="~/SeatMatrix/Delete/@seat.Id" class="btn btn-sm btn-danger" 
                                               onclick="return confirm('Are you sure?')">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>