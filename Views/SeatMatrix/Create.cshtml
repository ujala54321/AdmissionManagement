@{
}
@model AdmissionManagement.Models.ViewModels.SeatMatrixFormVm

<h2>Create Seat Matrix</h2>

<form asp-action="Create">
    <div class="form-group">
        <label>Program</label>
        <select asp-for="ProgramId" class="form-control"
                asp-items="@(new SelectList(Model.Programs, "Id", "Name"))">
            <option value="">-- Select Program --</option>
        </select>
    </div>

    <div class="form-group">
        <label>Academic Year</label>
        <select asp-for="AcademicYearId" class="form-control"
                asp-items="@(new SelectList(Model.AcademicYears, "Id", "Label"))">
            <option value="">-- Select Year --</option>
        </select>
    </div>

    <div class="form-group">
        <label>Total Intake</label>
        <input asp-for="TotalIntake" class="form-control" />
    </div>

    <div class="form-group">
        <label>KCET Seats</label>
        <input asp-for="KcetSeats" class="form-control" />
    </div>

    <div class="form-group">
        <label>COMEDK Seats</label>
        <input asp-for="ComedkSeats" class="form-control" />
    </div>

    <div class="form-group">
        <label>Management Seats</label>
        <input asp-for="ManagementSeats" class="form-control" />
    </div>

    <div class="form-group">
        <label>Supernumerary Seats</label>
        <input asp-for="SupernumerarySeats" class="form-control" />
    </div>

    <button type="submit" asp-action="Index" class="btn btn-success mt-2">Save</button>
    <a asp-action="Index" class="btn btn-secondary mt-2">Back</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}